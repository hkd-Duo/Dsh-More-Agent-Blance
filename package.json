{
  "name": "dsh-plugin-team-balancer",
  "version": "0.3.1",
  "description": "Weighted multi-AI balancing for DeepSeek Harness Agent Teams: the Lead is told to split substantial tasks across 2-4 teammates, routes survive restarts, parallel work goes to an idle provider first, and teammates rotate across DeepSeek, GLM and other providers while the Lead keeps its own model. Edited from a first-class sidebar panel.",
  "license": "MIT",
  "author": "hkd-Duo",
  "homepage": "https://github.com/hkd-Duo/Dsh-More-Agent-Blance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkd-Duo/Dsh-More-Agent-Blance.git"
  },
  "bugs": {
    "url": "https://github.com/hkd-Duo/Dsh-More-Agent-Blance/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-teams",
    "multi-agent",
    "llm-routing",
    "load-balancing",
    "glm",
    "deepseek"
  ],
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node tools/host-test.mjs && node tools/client-test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
